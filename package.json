{
  "name": "openreelbuilds",
  "version": "0.0.1",
  "description": "A service for Sparkle releases",
  "main": "server.js",
  "scripts": {
    "serve": "./bin/www",
    "test": "NODE_ENV=test ./node_modules/.bin/mocha -t 0 test/init.js test/**/*_test.js test/*/**/*_test.js",
    "migrate": "./node_modules/.bin/migrate up",
    "migrate_create": "./node_modules/.bin/migrate create"
  },
  "keywords": [
    "mac",
    "windows",
    "sparkle",
    "releases"
  ],
  "author": "Alex R. Young",
  "license": "MIT",
  "devDependencies": {
    "mocha": "^10.8.0",
    "supertest": "^7.0.0"
  },
  "dependencies": {
    "async": "^3.2.6",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.3",
    "cookie-parser": "^1.4.7",
    "cookie-session": "^2.1.0",
    "ejs": "^3.1.10",
    "express": "^4.21.0",
    "express-basic-auth": "^1.2.1",
    "express-ejs-layouts": "^2.5.1",
    "marked": "^4.3.0",
    "method-override": "^3.0.0",
    "migrate": "^2.1.0",
    "moment": "^2.30.1",
    "morgan": "^1.10.0",
    "node-sql-2": "^0.80.1",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-local": "^1.0.0",
    "pg": "^8.13.0"
  },
  "engines": {
    "node": "20.x",
    "npm": "10.x"
  }
}
